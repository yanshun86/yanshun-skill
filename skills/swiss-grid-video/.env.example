# 火山引擎 / 豆包语音配置（仅方案 C 需要；免费方案 A Edge TTS 无需此文件）
# 复制本文件为 .env 后填入真实凭证，切勿提交 .env 到 Git！

VOLC_TTS_API_KEY=your_volc_api_key_here
# 豆包声音复刻 2.0 填 seed-icl-2.0；官方标准音色填 seed-tts-1.0 或 seed-tts-2.0
VOLC_TTS_RESOURCE_ID=seed-icl-2.0
# 复刻音色 ID（如 S_xxxxxxxx）或官方音色 ID
VOLC_TTS_VOICE=S_your_cloned_voice_id
# 语速：0=1.0x，20=1.2x（推荐），范围 -50 ~ 100
VOLC_TTS_SPEED=20
